SENTRY_DSN=
# Firebase Console -> App Check -> web app -> reCAPTCHA v3 provider.
# Required for Gemini calls to work on the web build (main.dart skips App
# Check activation on web entirely when this is empty).
SITE_KEY_RECAPTCHA_SITE_KEY=
# Firebase Console -> App Check -> Apps -> Manage debug tokens.
# Optional for local dev (the SDK auto-generates + logs a per-install token
# if this is empty); CI's deploy-android.yml sets this to a fixed,
# pre-registered token so every tester's install shares one token.
APP_CHECK_DEBUG_TOKEN=
